# Copy to subtitle_pipeline/.env (gitignored). Local ops API.
VITUAL_MONGO_URI=mongodb://127.0.0.1:27018
VITUAL_MONGO_DB=vitual
VITUAL_ADMIN_TOKEN=local-admin
# Default 8901 (8800 blocked on some Windows Hyper-V port ranges)
VITUAL_PORT=8901
VITUAL_ALERT_WEBHOOK_URL=
VITUAL_SCHEDULE_ENABLED=true
VITUAL_SCHEDULE_DISCOVER=0 8 * * *
VITUAL_SCHEDULE_BATCH=30 8 * * *
VITUAL_SCHEDULE_GAME_CLAIM=0 22 * * 4
VITUAL_GAME_CLAIM_ENABLED=false
VITUAL_GAME_CLAIM_STORES=epic,steam
VITUAL_GAME_CLAIM_PROFILE_DIR=data/game_claim/browser
VITUAL_GAME_CLAIM_ARTIFACTS_DIR=data/game_claim/runs
VITUAL_GAME_CLAIM_HEADLESS=true
VITUAL_GAME_CLAIM_BROWSER_CHANNEL=chromium
VITUAL_GAME_CLAIM_PROFILE_NAME=
# To reuse a real local browser profile on Windows, for example:
# VITUAL_GAME_CLAIM_BROWSER_CHANNEL=msedge
# VITUAL_GAME_CLAIM_PROFILE_DIR=C:/Users/<you>/AppData/Local/Microsoft/Edge/User Data
# VITUAL_GAME_CLAIM_PROFILE_NAME=Default
# Optional: comma-separated direct product URLs for stubborn pages.
# VITUAL_GAME_CLAIM_EPIC_URLS=https://store.epicgames.com/en-US/p/example
# VITUAL_GAME_CLAIM_STEAM_URLS=https://store.steampowered.com/app/123456/example/

# Netscape cookies for Douyin (file wins over --cookies-from-browser).
# Or place cookies.txt next to this package: subtitle_pipeline/cookies.txt
# VITUAL_COOKIES=D:/MineWeb/2026/Vitual/subtitle_pipeline/cookies.txt

# WF-09 publish accounts (JSON, gitignored). Separate from download cookies.
# VITUAL_PUBLISH_ACCOUNTS=D:/MineWeb/2026/Vitual/subtitle_pipeline/data/publish_accounts.json

# Parallel languages for subtitle translate + notes localize (1–8, default 2).
# VITUAL_LANG_WORKERS=2

# Parallel ffmpeg GIF/MP4 cuts (1–8, default 2).
# VITUAL_CLIP_WORKERS=2
